# Bu dosyayı .env olarak kopyala ve Supabase > Project Settings > API sayfasındaki değerlerle doldur.
# Publishable (anon) anahtar istemcide durabilir; güvenliği RLS sağlar.
# service_role / secret anahtarı ASLA buraya yazma.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
